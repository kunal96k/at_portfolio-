# ============================================
# Environment Variables Template (Dev & Prod)
# ============================================

# Backend Spring Boot API Base URL:
# - Local development: http://localhost:8080
# - Cross-origin HTTPS production (Vercel + separate API server): https://api.arvindthevar.com
# - Same-origin Nginx reverse proxy (https://arvindthevar.com/api/...): /
VITE_API_BASE_URL=https://api.arvindthevar.com

# Canonical Production Site URL (HTTPS)
VITE_SITE_URL=https://arvindthevar.com

# Search Engine Verification Keys (Optional - set tokens when verifying with Google & Bing)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# GEMINI_API_KEY: Optional - used for AI features if enabled
GEMINI_API_KEY=
