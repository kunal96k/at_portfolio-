# ============================================
# Environment Variables Template
# ============================================

# Backend Spring Boot API Base URL (default: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# Canonical Site URL
VITE_SITE_URL=https://arvindthevar.vercel.app

# Search Engine Verification Keys (Optional - set tokens when verifying with Google & Bing)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# GEMINI_API_KEY: Optional - used for AI features if enabled
GEMINI_API_KEY=
